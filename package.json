{
  "name": "obsidian-webdav-proxy-sync",
  "version": "0.3.1",
  "description": "Cross-platform Obsidian WebDAV sync with optional desktop proxy support",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "webdav",
    "sync",
    "proxy",
    "socks5"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5"
  },
  "author": "liushm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushm/obsidian-webdav-proxy-sync.git"
  },
  "bugs": {
    "url": "https://github.com/liushm/obsidian-webdav-proxy-sync/issues"
  },
  "homepage": "https://github.com/liushm/obsidian-webdav-proxy-sync#readme"
}
